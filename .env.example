# =======================================================
# CGC PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================

# Server Configuration
PORT=5055
NODE_ENV=production
APP_URL=http://localhost:3000
API_URL=http://localhost:5055

# JWT Secret for Session Signatures (generate a secure random 64-char string)
JWT_SECRET=replace_with_super_secret_jwt_random_key_for_production

# Lead Admin Initial Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_admin_password_min_8_chars

# Chapa Payment Gateway (https://developer.chapa.co/)
# In Test/Sandbox: use 'CHASECK_TEST-...'
# In Production: use 'CHASECK-...'
CHAPA_SECRET_KEY=CHASECK_TEST-placeholder-merchant-key
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-placeholder-merchant-key
CHAPA_WEBHOOK_SECRET=replace_with_webhook_secret_hash_from_chapa_dashboard
CHAPA_API_URL=https://api.chapa.co/v1

# Ethio Telecom Telebirr Direct Gateway (https://developer.ethiotelecom.et/)
# Optional: used when direct enterprise Fabric App keys are issued
TELEBIRR_APP_ID=placeholder_fabric_app_id
TELEBIRR_SHORT_CODE=10001
TELEBIRR_PUBLIC_KEY=""
TELEBIRR_PRIVATE_KEY=""
TELEBIRR_API_URL=https://developerportal.ethiotelecom.et:38443/apiaccess/payment/gateway
